# Cloudflare Pages / Netlify Security & Performance Headers
# Technical SEO & Core Web Vitals Optimization

# Global Rules for all files
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Static Assets Caching (1 Year Cache for Static CSS/JS/Images)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.js
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# HTML Pages - Always Fresh Revalidation
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# XML Sitemap & Robots.txt Directives
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=86400, stale-while-revalidate=43200

/sitemap_articles.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=86400, stale-while-revalidate=43200

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/manifest.json
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400

# IndexNow Key File
/*.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400
